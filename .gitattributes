# GitHub Linguist hints

# Force .m → Objective-C (Linguist also considers MATLAB / Mercury for .m).
*.m linguist-language=Objective-C

# docs.json is generated by `make docs` from Lua/Obj-C source comments.
sloppyfocus/docs.json linguist-generated=true

# Exclude build/loader scaffolding from language stats so the bar
# reflects the substantive Objective-C code, not the Makefile + Lua
# stub that outweigh it by byte count.
Makefile             linguist-detectable=false
sloppyfocus/init.lua linguist-detectable=false
